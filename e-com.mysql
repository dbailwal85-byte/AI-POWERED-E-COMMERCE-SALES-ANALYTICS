SHOW TABLES;

DESCRIBE Customers;
DESCRIBE Products;
DESCRIBE Orders;

SELECT * FROM Customers;
SELECT * FROM Products;
SELECT * FROM Orders;

SELECT COUNT(*) FROM Customers;
SELECT COUNT(*) FROM Products;
SELECT COUNT(*) FROM Orders;

SELECT Customer_Name
FROM Customers;

SELECT Product_Name
FROM Products;

SELECT Order_ID
FROM Orders;

SELECT DISTINCT City
FROM Customers;

SELECT DISTINCT Category
FROM Products;

SELECT *
FROM Orders
WHERE Sales > 5000;

SELECT *
FROM Orders
WHERE Profit > 1000;

SELECT *
FROM Orders
WHERE Quantity > 2;

SELECT *
FROM Customers
WHERE Customer_Type='Premium';

SELECT *
FROM Customers
WHERE Gender='Female';

SELECT *
FROM Products
WHERE Category='Electronics';

SELECT *
FROM Products
WHERE Unit_Price BETWEEN 500 AND 2000;

SELECT *
FROM Orders
WHERE Payment_Method='UPI';

SELECT *
FROM Orders
WHERE Shipping_Mode='Express';

SELECT *
FROM Customers
WHERE City='Delhi';

SELECT *
FROM Customers
WHERE Age > 30;


SELECT *
FROM Customers
ORDER BY Age DESC;

SELECT *
FROM Products
ORDER BY Unit_Price DESC;

SELECT *
FROM Orders
ORDER BY Sales DESC
LIMIT 10;


SELECT SUM(Sales) AS Total_Revenue
FROM Orders;

SELECT SUM(Profit) AS Total_Profit
FROM Orders;

SELECT AVG(Customer_Rating) AS Avg_Rating
FROM Orders;

SELECT COUNT(*) AS Total_Orders
FROM Orders;

SELECT
P.Category,
SUM(O.Sales) AS Total_Sales
FROM Orders O
JOIN Products P
ON O.Product_Name=P.Product_Name
GROUP BY P.Category;

SELECT
C.Region,
SUM(O.Sales) AS Total_Sales
FROM Orders O
JOIN Customers C
ON O.Customer_ID=C.Customer_ID
GROUP BY C.Region;

SELECT
Payment_Method,
SUM(Sales) AS Revenue
FROM Orders
GROUP BY Payment_Method;

SELECT
Payment_Method,
SUM(Sales) AS Revenue
FROM Orders
GROUP BY Payment_Method
HAVING Revenue > 10000;

SELECT
C.Customer_Name,
O.Order_ID,
O.Sales
FROM Customers C
INNER JOIN Orders O
ON C.Customer_ID=O.Customer_ID;

SELECT
P.Product_Name,
P.Category,
SUM(O.Quantity) AS Quantity_Sold,
SUM(O.Sales) AS Revenue
FROM Products P
INNER JOIN Orders O
ON P.Product_Name=O.Product_Name
GROUP BY P.Product_Name,P.Category;

SELECT
Customer_ID,
SUM(Sales) AS Revenue
FROM Orders
GROUP BY Customer_ID
ORDER BY Revenue DESC
LIMIT 10;

SELECT
Product_Name,
SUM(Quantity) AS Quantity_Sold
FROM Orders
GROUP BY Product_Name
ORDER BY Quantity_Sold DESC;

SELECT
MONTH(Order_Date) AS Month,
SUM(Sales) AS Revenue
FROM Orders
GROUP BY Month;

SELECT
P.Category,
SUM(O.Profit) AS Profit
FROM Orders O
JOIN Products P
ON O.Product_Name=P.Product_Name
GROUP BY P.Category;

SELECT
C.Region,
SUM(O.Sales) AS Revenue
FROM Orders O
JOIN Customers C
ON O.Customer_ID=C.Customer_ID
GROUP BY C.Region;

CREATE VIEW Customer_Revenue_View AS
SELECT
Customer_ID,
SUM(Sales) AS Revenue
FROM Orders
GROUP BY Customer_ID;

CREATE VIEW Monthly_Sales_View AS
SELECT
MONTH(Order_Date) AS Month,
SUM(Sales) AS Revenue
FROM Orders
GROUP BY Month;

CREATE VIEW Product_Performance_View AS
SELECT
Product_Name,
SUM(Quantity) AS Quantity_Sold,
SUM(Sales) AS Revenue
FROM Orders
GROUP BY Product_Name;

DELIMITER $$

CREATE PROCEDURE GetCustomerRevenue()
BEGIN
    SELECT Customer_ID,
           SUM(Sales) AS Revenue
    FROM Orders
    GROUP BY Customer_ID;
END$$

DELIMITER ;

CALL GetCustomerRevenue();


DELIMITER $$

CREATE PROCEDURE GetMonthlySales()
BEGIN
    SELECT MONTH(Order_Date) AS Month,
           SUM(Sales) AS Revenue
    FROM Orders
    GROUP BY Month;
END$$

DELIMITER ;

CALL GetMonthlySales();

DELIMITER $$

CREATE PROCEDURE TopSellingProducts()
BEGIN
    SELECT Product_Name,
           SUM(Quantity) AS Quantity_Sold
    FROM Orders
    GROUP BY Product_Name
    ORDER BY Quantity_Sold DESC;
END$$

DELIMITER ;

CALL TopSellingProducts();